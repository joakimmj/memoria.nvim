#!/usr/bin/env -S nvim -l
-- The CLI's executable. See |memoria-cli|.
local script = vim.uv.fs_realpath(_G.arg[0]) or _G.arg[0]
local root = vim.fn.fnamemodify(script, ":p:h:h")
package.path = ("%s/lua/?.lua;%s/lua/?/init.lua;"):format(root, root) .. package.path
-- Loaded before the user's config, so a plugin manager's own loader cannot
-- answer a later require("memoria") with another copy.
require("memoria")
os.exit(require("memoria.cli").main(_G.arg))
